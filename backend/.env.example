# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/movie_app

# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Long random string used to sign JWTs, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional: OAuth Client ID from Google Cloud Console (enables "Continue with Google")
GOOGLE_CLIENT_ID=
